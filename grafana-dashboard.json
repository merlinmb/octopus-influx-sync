{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "Your InfluxDB datasource (must be configured with Flux query language)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "influxdb",
      "name": "InfluxDB",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "templating": {
    "list": [
      {
        "name": "gas_unit_rate_pence",
        "type": "constant",
        "label": "Gas Unit Rate (p/kWh)",
        "description": "Your gas standing unit rate in pence per kWh. Update this when your tariff changes.",
        "query": "6.24",
        "current": { "value": "6.24", "text": "6.24" },
        "hide": 0
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "title": "Total Electricity Cost (Current View)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "refId": "A",
          "query": "consumption = from(bucket: \"idb_measurements/autogen\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"electricity_consumption\" and r._field == \"consumption_kwh\")\n\ntariff = from(bucket: \"idb_measurements/autogen\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"electricity_tariff\" and r._field == \"unit_rate_pence\")\n\njoin(tables: {c: consumption, t: tariff}, on: [\"_time\"])\n  |> map(fn: (r) => ({_time: r._time, _value: r._value_c * r._value_t / 100.0}))\n  |> sum(column: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 2,
      "title": "Last Month — Electricity Cost",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "refId": "A",
          "query": "import \"date\"\nthisMonth = date.truncate(t: now(), unit: 1mo)\nlastMonth = date.sub(d: 1mo, from: thisMonth)\n\nconsumption = from(bucket: \"idb_measurements/autogen\")\n  |> range(start: lastMonth, stop: thisMonth)\n  |> filter(fn: (r) => r._measurement == \"electricity_consumption\" and r._field == \"consumption_kwh\")\n\ntariff = from(bucket: \"idb_measurements/autogen\")\n  |> range(start: lastMonth, stop: thisMonth)\n  |> filter(fn: (r) => r._measurement == \"electricity_tariff\" and r._field == \"unit_rate_pence\")\n\njoin(tables: {c: consumption, t: tariff}, on: [\"_time\"])\n  |> map(fn: (r) => ({_time: r._time, _value: r._value_c * r._value_t / 100.0}))\n  |> sum(column: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 3,
      "title": "Last Month — Gas Cost",
      "description": "Calculated using the Gas Unit Rate variable (p/kWh). Update the dashboard variable if your tariff changes.",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "refId": "A",
          "query": "import \"date\"\nthisMonth = date.truncate(t: now(), unit: 1mo)\nlastMonth = date.sub(d: 1mo, from: thisMonth)\n\nfrom(bucket: \"idb_measurements/autogen\")\n  |> range(start: lastMonth, stop: thisMonth)\n  |> filter(fn: (r) => r._measurement == \"gas_consumption\" and r._field == \"consumption_m3\")\n  |> map(fn: (r) => ({_time: r._time, _value: r._value * 39.2 / 3.6 * ${gas_unit_rate_pence} / 100.0}))\n  |> sum(column: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "id": 4,
      "title": "Electricity Cost Over Time",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "refId": "A",
          "query": "consumption = from(bucket: \"idb_measurements/autogen\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"electricity_consumption\" and r._field == \"consumption_kwh\")\n\ntariff = from(bucket: \"idb_measurements/autogen\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"electricity_tariff\" and r._field == \"unit_rate_pence\")\n\njoin(tables: {c: consumption, t: tariff}, on: [\"_time\"])\n  |> map(fn: (r) => ({_time: r._time, _value: r._value_c * r._value_t / 100.0, _field: \"cost_gbp\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyGBP",
          "decimals": 4,
          "displayName": "Cost (£)",
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 70,
            "gradientMode": "none",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },

    {
      "id": 5,
      "title": "Gas Consumption (Converted to kWh)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "refId": "B",
          "query": "from(bucket: \"idb_measurements/autogen\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"gas_consumption\" and r._field == \"consumption_m3\")\n  |> map(fn: (r) => ({r with _value: r._value * 39.2 / 3.6, _field: \"consumption_kwh\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwh",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },

    {
      "id": 6,
      "title": "Electricity: Agile Rates vs Consumption",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "refId": "C",
          "query": "from(bucket: \"idb_measurements/autogen\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"electricity_consumption\" and r._field == \"consumption_kwh\")"
        },
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "refId": "D",
          "query": "from(bucket: \"idb_measurements/autogen\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"electricity_tariff\" and r._field == \"unit_rate_pence\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwh",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 1,
            "fillOpacity": 50,
            "gradientMode": "none",
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "unit_rate_pence" },
            "properties": [
              { "id": "displayName", "options": "Agile Rate (p/kWh)" },
              { "id": "unit", "options": "short" },
              { "id": "custom.drawStyle", "options": "line" },
              { "id": "custom.lineWidth", "options": 2 },
              { "id": "custom.fillOpacity", "options": 0 },
              { "id": "custom.axisPlacement", "options": "right" },
              { "id": "custom.axisLabel", "options": "p/kWh" },
              { "id": "color", "options": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "consumption_kwh" },
            "properties": [
              { "id": "displayName", "options": "Consumption (kWh)" },
              { "id": "color", "options": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      }
    }

  ],
  "schemaVersion": 38,
  "title": "Energy & Billing Dashboard",
  "uid": "energy_billing_001"
}
