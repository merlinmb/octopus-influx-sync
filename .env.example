# ── Octopus Energy ────────────────────────────────────────────────────────────
# Your API key from https://octopus.energy/dashboard/developer/
OCTOPUS_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Optional: enables EV smart-dispatch sync using the Octopus GraphQL API.
OCTOPUS_ACCOUNT_NUMBER=A-XXXXXX

# ── Monthly costs dashboard ───────────────────────────────────────────────────
DASHBOARD_PORT=3002
GAS_UNIT_RATE_PENCE=6.24

# ── EV efficiency chart (optional) ────────────────────────────────────────────
# Cumulative odometer readings used for the mi/kWh chart. The values are read
# from another InfluxDB database; UNIT is "mi" or "km" (km is converted to miles).
# Volvo reports kilometres, which is the default. Defaults match the mcmdhome
# Volvo bridge: environmentals / mcmdhome/volvo/odometer.
# VOLVO_ODOMETER_DATABASE=environmentals
# VOLVO_ODOMETER_MEASUREMENT=mcmdhome/volvo/odometer
# VOLVO_ODOMETER_UNIT=km

# ── Optional: force a full historical backfill ────────────────────────────────
# Set BACKFILL_DAYS to override the last-stored-timestamp logic and re-fetch
# that many days of history. Remove (or leave blank) after the backfill run
# to resume normal incremental syncing.
# BACKFILL_DAYS=365

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_HOST=192.168.1.55
INFLUXDB_PORT=8086
INFLUXDB_PROTOCOL=http
INFLUXDB_DATABASE=idb_measurements
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=your_influxdb_password_here
